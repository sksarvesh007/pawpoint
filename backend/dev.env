# =============================================================================
# PawPoint Backend - DEVELOPMENT Environment
# =============================================================================
# This file is loaded when ENVIRONMENT="development" in config.py
# Safe for version control in PRIVATE repositories
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
# Development secret key - NEVER use this in production
SECRET_KEY=dev-secret-key-for-local-development-only-do-not-use-in-prod

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,https://pawpoint-psi.vercel.app,https://aaa006e18f61.ngrok-free.app

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development database (Docker: port 5434, local: port 5432)
DATABASE_URL=postgresql+asyncpg://pawpoint:localdevonly@localhost:5434/pawpoint
DATABASE_ECHO=true

# -----------------------------------------------------------------------------
# Redis (Upstash - production-ready, works locally too)
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:AbiGAAIncDIwMjgzOWQ2OWQzYWQ0YzRiYjg1YzRmNzljY2YyZTk5YnAyNDcyMzg@huge-viper-47238.upstash.io:6379

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# External APIs (development/sandbox keys - use test/sandbox accounts)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-...  # Not needed - using DeepSeek
GOOGLE_API_KEY=AIzaSyCuuCJWpb0DUuzrY1AvQFux5Xlpnod0HmA

# DeepSeek LLM (OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-qFPEqgpxmS8DJ0nJQ6gvdIkozY1k2oEZER2A4zRhLxBvtIHl
DEEPSEEK_BASE_URL=https://api.lkeap.cloud.tencent.com/v1
DEEPSEEK_MODEL=deepseek-v3-0324
# GOOGLE_VERTEX_PROJECT_ID=your-gcp-project-id  # For Vertex AI (optional)
# GOOGLE_VERTEX_REGION=us-central1

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO for local dev)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=pawpoint-recordings
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Twilio (for SIP trunk phone integration)
# Get credentials from: https://console.twilio.com/
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# -----------------------------------------------------------------------------
# LiveKit (for real-time voice AI)
# Generate keys with: docker run --rm livekit/livekit-server generate-keys
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=APIZEvT7i9zvss3
LIVEKIT_API_SECRET=B3FeyCkAutnWnSmppnJREXaVGeWdBRTyFvm55WDzMRx
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
# Set to true to run agent embedded in FastAPI (for Render free tier)
# Set to false for local development with separate agent process
LIVEKIT_AGENT_EMBEDDED=false

# -----------------------------------------------------------------------------
# Voice AI Providers
# -----------------------------------------------------------------------------
# AssemblyAI - Speech-to-Text (STT)
# Get API key from: https://www.assemblyai.com/dashboard/
ASSEMBLYAI_API_KEY=cfa606370e61444baf60bed46b9eab6e

# Cartesia - Text-to-Speech (TTS)
# Get API key from: https://play.cartesia.ai/
CARTESIA_API_KEY=sk_car_1VGkycmq9Kvn7LYPYgUVgH

# -----------------------------------------------------------------------------
# PIMS Integration (sandbox/test credentials)
# -----------------------------------------------------------------------------
# EZYVET_CLIENT_ID=dev-client-id
# EZYVET_CLIENT_SECRET=dev-client-secret
# VETSPIRE_API_KEY=dev-api-key

# -----------------------------------------------------------------------------
# AI / LLM Configuration (DeepSeek as primary)
# -----------------------------------------------------------------------------
LLM_VOICE_MODEL=deepseek-v3-0324
LLM_REASONING_MODEL=deepseek-v3-0324
LLM_DEFAULT_MODEL=deepseek-v3-0324
LLM_USE_DEEPSEEK=true
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=30
CONVERSATION_SESSION_TTL_SECONDS=1800
CONVERSATION_MAX_HISTORY=20

# -----------------------------------------------------------------------------
# OpenTelemetry / Observability (Local Grafana Stack)
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=pawpoint-api-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# OTEL_EXPORTER_OTLP_HEADERS=  # Not needed for local
PROMETHEUS_ENABLED=true

# -----------------------------------------------------------------------------
# Monitoring & Security
# -----------------------------------------------------------------------------
METRICS_USERNAME=prometheus
METRICS_PASSWORD=dev-metrics-password-change-in-prod
# SENTRY_DSN=  # Optional: Sentry error tracking

