# =============================================================================
# PawPoint Backend Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=<your-secret-key>

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For running inside docker-compose (backend connects to db service):
DATABASE_URL=postgresql+asyncpg://<user>:<password>@db:5432/pawpoint
# For running locally outside docker (connect to docker db on mapped port):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5434/pawpoint
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# External APIs (uncomment when needed)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...

# -----------------------------------------------------------------------------
# PIMS Integration (uncomment when needed)
# -----------------------------------------------------------------------------
# EZYVET_CLIENT_ID=...
# EZYVET_CLIENT_SECRET=...

# -----------------------------------------------------------------------------
# OpenTelemetry / Observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=pawpoint-api
# For local development (docker-compose):
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# For Grafana Cloud (production):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net:443
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <your-token>
PROMETHEUS_ENABLED=true

