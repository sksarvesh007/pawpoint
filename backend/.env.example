# =============================================================================
# PawPoint Backend Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=<your-secret-key>

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For running inside docker-compose (backend connects to db service):
DATABASE_URL=postgresql+asyncpg://<user>:<password>@db:5432/pawpoint
# For running locally outside docker (connect to docker db on mapped port):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5434/pawpoint
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# DeepSeek LLM (primary AI provider)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.lkeap.cloud.tencent.com/v1
DEEPSEEK_MODEL=deepseek-v3-0324

# -----------------------------------------------------------------------------
# External APIs (uncomment when needed)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=<your-google-api-key>
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...

# -----------------------------------------------------------------------------
# LiveKit Voice AI (uncomment to enable voice features)
# Generate keys with: docker run --rm livekit/livekit-server generate-keys
# -----------------------------------------------------------------------------
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxx
# LIVEKIT_URL=http://livekit:7880
# LIVEKIT_WS_URL=ws://localhost:7880

# Voice AI Providers
# ASSEMBLYAI_API_KEY=<your-assemblyai-key>  # For STT
# CARTESIA_API_KEY=<your-cartesia-key>       # For TTS

# -----------------------------------------------------------------------------
# PIMS Integration (uncomment when needed)
# -----------------------------------------------------------------------------
# EZYVET_CLIENT_ID=...
# EZYVET_CLIENT_SECRET=...

# -----------------------------------------------------------------------------
# OpenTelemetry / Observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=pawpoint-api
# For local development (docker-compose):
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# For Grafana Cloud (production):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net:443
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <your-token>
PROMETHEUS_ENABLED=true

